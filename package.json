{
  "name": "react-square-image-gallery",
  "version": "1.0.1",
  "description": "React square image gallery component",
  "license": "MIT",
  "author": "Schwarzová, Tereza",
  "homepage": "https://github.com/schwarzova/react-square-image-gallery",
  "repository": {
    "type": "git",
    "url": "https://github.com/schwarzova/react-square-image-gallery"
  },
  "keywords": [
    "react",
    "typescript",
    "react gallery",
    "image gallery",
    "square gallery",
    "gallery"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "tsup --watch",
    "build": "tsup",
    "test": "echo \"No tests yet\" && exit 0",
    "prepare": "tsup",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/index.mjs",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.0.2",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/addon-links": "^8.6.0",
    "@storybook/blocks": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@storybook/test": "^8.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "husky": "^9.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "size-limit": "^11.0.2",
    "storybook": "^8.6.0",
    "tslib": "^2.6.2",
    "vite": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0"
  }
}
